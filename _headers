# Cabeçalhos aplicados pela Netlify (arquivo lido em qualquer tipo de deploy).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# O HTML precisa ser revalidado sempre, senão uma atualização do site
# demora a chegar em quem já visitou.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Fotos e vídeo: uma semana de cache. Tempo suficiente para a performance
# e curto o bastante para uma foto trocada aparecer sem dor de cabeça.
/assets/img/*
  Cache-Control: public, max-age=604800
/assets/video/*
  Cache-Control: public, max-age=604800

# Fontes e folhas de estilo praticamente não mudam.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=86400
/assets/js/*
  Cache-Control: public, max-age=86400

# Segunda página do site (Lentes em Resina Estratificada — Art Barra):
# mesmas regras, num segundo conjunto de assets isolado em /lentes-resina/.
/lentes-resina/
  Cache-Control: public, max-age=0, must-revalidate
/lentes-resina/index.html
  Cache-Control: public, max-age=0, must-revalidate
/lentes-resina/assets/img/*
  Cache-Control: public, max-age=604800
/lentes-resina/assets/video/*
  Cache-Control: public, max-age=604800
/lentes-resina/assets/css/*
  Cache-Control: public, max-age=86400
/lentes-resina/assets/js/*
  Cache-Control: public, max-age=86400
